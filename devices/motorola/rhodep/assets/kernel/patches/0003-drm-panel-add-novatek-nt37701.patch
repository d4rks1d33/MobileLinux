From: postmarketOS rhodep port
Subject: [PATCH] drm/panel: add Novatek NT37701 DSI panel driver

CSOT/Tianma NT37701 based 6.55" 1080x2400 AMOLED DSC 1.1 command mode
panel as found in the Motorola Moto G82 5G (rhodep). Generated with
linux-mdss-dsi-panel-driver-generator from the vendor device tree and
matched against panel revision v1, which is what the bootloader reports
via msm_drm.dsi_display0=...nt37701_655_1080x2400_dsc_cmd_v1:timing1.

--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-novatek-nt37701.c
@@ -0,0 +1,514 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (c) 2026 FIXME
+// Generated with linux-mdss-dsi-panel-driver-generator from vendor device tree:
+//   Copyright (c) 2013, The Linux Foundation. All rights reserved. (FIXME)
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+#include <linux/moduleparam.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct nt37701 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct regulator_bulk_data *supplies;
+	struct gpio_desc *reset_gpio;
+};
+
+/*
+ * Diagnostic switches. The panel configures its DSC decoder through its own
+ * registers (0x90/0x91) during the power on sequence, so the standard PPS and
+ * the "compression mode" command may be redundant or even get in the way.
+ * They can be changed at runtime and applied with:
+ *   echo 1 > /sys/class/graphics/fb0/blank; echo 0 > /sys/class/graphics/fb0/blank
+ */
+static bool send_pps = true;
+module_param(send_pps, bool, 0644);
+MODULE_PARM_DESC(send_pps, "enviar el PPS estandar (default 1)");
+
+static bool send_cmode = true;
+module_param(send_cmode, bool, 0644);
+MODULE_PARM_DESC(send_cmode, "enviar mipi_dsi_compression_mode (default 1)");
+
+/*
+ * DSI link clock scale, as a percentage.
+ *
+ * Mainline sizes the pixel clock at the theoretical minimum
+ * (htotal * vtotal * fps). In command mode that makes the compressed frame
+ * transfer take about 81% of the refresh period, so the panel reads lines that
+ * have not been written yet, which shows up as flickering corrupted bands. The
+ * PHY timings of the stock firmware work out to about 880 Mbps per lane, some
+ * 2.3x the minimum: Qualcomm deliberately runs the link faster to leave slack.
+ */
+static int clk_scale = 230;
+module_param(clk_scale, int, 0644);
+MODULE_PARM_DESC(clk_scale, "DSI clock scale in % (100 = theoretical minimum)");
+
+static bool pps_first = false;
+module_param(pps_first, bool, 0644);
+MODULE_PARM_DESC(pps_first, "send PPS before the power on sequence (default 0)");
+
+static const struct regulator_bulk_data nt37701_supplies[] = {
+	{ .supply = "vddio" },
+	{ .supply = "vci" },
+	{ .supply = "dvdd" },
+};
+
+static inline
+struct nt37701 *to_nt37701(struct drm_panel *panel)
+{
+	return container_of_const(panel, struct nt37701, panel);
+}
+
+static void nt37701_reset(struct nt37701 *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(11000, 12000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(11000, 12000);
+}
+
+static int nt37701_on(struct nt37701 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0,
+				     0x55, 0xaa, 0x52, 0x08, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6f, 0x06);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb5, 0x4b, 0x22, 0x4f);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0,
+				     0x55, 0xaa, 0x52, 0x08, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb2, 0x18);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6f, 0x0f);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb2,
+				     0x60, 0x50, 0x65, 0xe9, 0x85, 0xe9, 0x2f,
+				     0xff);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb3,
+				     0x00, 0x01, 0x01, 0x59, 0x01, 0x59, 0x02,
+				     0x1a, 0x02, 0x1a, 0x03, 0x0a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6f, 0x0c);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb3,
+				     0x03, 0x0a, 0x04, 0x00, 0x04, 0x00, 0x05,
+				     0xe9, 0x05, 0xe9, 0x05, 0xea);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6f, 0x18);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb3,
+				     0x05, 0xea, 0x09, 0x08, 0x09, 0x08, 0x0d,
+				     0xbb, 0x0d, 0xbb, 0x0f, 0xff);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x58, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0,
+				     0x55, 0xaa, 0x52, 0x08, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6f, 0x1c);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc0,
+				     0x03, 0x14, 0x25, 0xa9, 0x78);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0xaa, 0x55, 0xa5, 0x80);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6f, 0x1d);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf2, 0x05);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x03, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x90, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x91,
+				     0xab, 0x28, 0x00, 0x0c, 0xc2, 0x00, 0x03,
+				     0x1c, 0x01, 0x7e, 0x00, 0x0f, 0x08, 0xbb,
+				     0x04, 0x3d, 0x10, 0xf0);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_MEMORY_START,
+				     0x00);
+	mipi_dsi_dcs_set_display_brightness_multi(&dsi_ctx, 0x0000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+				     0x20);
+	mipi_dsi_dcs_set_tear_on_multi(&dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+	mipi_dsi_dcs_set_column_address_multi(&dsi_ctx, 0x0000, 0x0437);
+	mipi_dsi_dcs_set_page_address_multi(&dsi_ctx, 0x0000, 0x095f);
+	/* timing@1 = 60 Hz, the configuration the stock firmware uses */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x2f, 0x03);
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+
+	return dsi_ctx.accum_err;
+}
+
+static int nt37701_off(struct nt37701 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	/*
+	 * The vendor DT declares a zero wait between display off and sleep in.
+	 * Without any margin the DDIC ends up in a state it does not recover
+	 * from on reinit (garbage shows up after the first DPMS cycle), so
+	 * keep the usual minimum for this panel.
+	 */
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	return dsi_ctx.accum_err;
+}
+
+static int nt37701_send_dsc_cfg(struct nt37701 *ctx)
+{
+	struct drm_dsc_picture_parameter_set pps;
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	/*
+	 * The vendor DT declares qcom,bl-dsc-cmd-state = "dsi_hs_mode": the DSC
+	 * setup travels in high speed mode, not in LPM.
+	 */
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	if (send_pps) {
+		drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+		ret = mipi_dsi_picture_parameter_set(ctx->dsi, &pps);
+		if (ret < 0) {
+			dev_err(dev, "failed to transmit PPS: %d\n", ret);
+			goto out;
+		}
+	}
+
+	if (send_cmode) {
+		ret = mipi_dsi_compression_mode(ctx->dsi, true);
+		if (ret < 0) {
+			dev_err(dev, "failed to enable compression mode: %d\n", ret);
+			goto out;
+		}
+	}
+
+	ret = 0;
+out:
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	return ret;
+}
+
+static int nt37701_prepare(struct drm_panel *panel)
+{
+	struct nt37701 *ctx = to_nt37701(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(nt37701_supplies), ctx->supplies);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	/* Wait for the supplies to settle before releasing reset */
+	msleep(10);
+
+	nt37701_reset(ctx);
+
+	if (pps_first) {
+		ret = nt37701_send_dsc_cfg(ctx);
+		if (ret < 0)
+			dev_err(dev, "PPS previo fallo: %d\n", ret);
+	}
+
+	ret = nt37701_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(nt37701_supplies), ctx->supplies);
+		return ret;
+	}
+
+	if (!pps_first) {
+		ret = nt37701_send_dsc_cfg(ctx);
+		if (ret < 0)
+			return ret;
+	}
+
+	msleep(28); /* TODO: Is this panel-dependent? */
+
+	return 0;
+}
+
+static int nt37701_unprepare(struct drm_panel *panel)
+{
+	struct nt37701 *ctx = to_nt37701(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = nt37701_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(nt37701_supplies), ctx->supplies);
+
+	/* Give the supplies time to drop before powering up again */
+	msleep(100);
+
+	return 0;
+}
+
+static const struct drm_display_mode nt37701_modes[] = {
+	{ /* 1080x2400 @ 48Hz */
+		.clock = (1080 + 32 + 16 + 32) * (2400 + 12 + 4 + 4) * 48 / 1000,
+		.hdisplay = 1080,
+		.hsync_start = 1080 + 32,
+		.hsync_end = 1080 + 32 + 16,
+		.htotal = 1080 + 32 + 16 + 32,
+		.vdisplay = 2400,
+		.vsync_start = 2400 + 12,
+		.vsync_end = 2400 + 12 + 4,
+		.vtotal = 2400 + 12 + 4 + 4,
+		.width_mm = 68,
+		.height_mm = 152,
+		.type = DRM_MODE_TYPE_DRIVER,
+	},
+	{ /* 1080x2400 @ 60Hz */
+		.clock = (1080 + 32 + 16 + 32) * (2400 + 12 + 4 + 4) * 60 / 1000,
+		.hdisplay = 1080,
+		.hsync_start = 1080 + 32,
+		.hsync_end = 1080 + 32 + 16,
+		.htotal = 1080 + 32 + 16 + 32,
+		.vdisplay = 2400,
+		.vsync_start = 2400 + 12,
+		.vsync_end = 2400 + 12 + 4,
+		.vtotal = 2400 + 12 + 4 + 4,
+		.width_mm = 68,
+		.height_mm = 152,
+		.type = DRM_MODE_TYPE_DRIVER,
+	},
+	{ /* 1080x2400 @ 90Hz */
+		.clock = (1080 + 32 + 16 + 32) * (2400 + 12 + 4 + 4) * 90 / 1000,
+		.hdisplay = 1080,
+		.hsync_start = 1080 + 32,
+		.hsync_end = 1080 + 32 + 16,
+		.htotal = 1080 + 32 + 16 + 32,
+		.vdisplay = 2400,
+		.vsync_start = 2400 + 12,
+		.vsync_end = 2400 + 12 + 4,
+		.vtotal = 2400 + 12 + 4 + 4,
+		.width_mm = 68,
+		.height_mm = 152,
+		.type = DRM_MODE_TYPE_DRIVER,
+	},
+	{ /* 1080x2400 @ 120Hz */
+		.clock = (1080 + 32 + 16 + 32) * (2400 + 12 + 4 + 4) * 120 / 1000,
+		.hdisplay = 1080,
+		.hsync_start = 1080 + 32,
+		.hsync_end = 1080 + 32 + 16,
+		.htotal = 1080 + 32 + 16 + 32,
+		.vdisplay = 2400,
+		.vsync_start = 2400 + 12,
+		.vsync_end = 2400 + 12 + 4,
+		.vtotal = 2400 + 12 + 4 + 4,
+		.width_mm = 68,
+		.height_mm = 152,
+		.type = DRM_MODE_TYPE_DRIVER,
+	},
+};
+
+static int nt37701_get_modes(struct drm_panel *panel,
+						       struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+	int count = 0;
+
+	/*
+	 * The power on sequence selects 60 Hz (register 0x2f = 0x03), so only
+	 * that mode is exposed.
+	 *
+	 * The clock is scaled by clk_scale so the compressed frame transfer
+	 * finishes well before the next TE.
+	 */
+	mode = drm_mode_duplicate(connector->dev, &nt37701_modes[1]);
+	if (!mode)
+		return 0;
+
+	if (clk_scale != 100)
+		mode->clock = mult_frac(mode->clock, clk_scale, 100);
+
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+	count = 1;
+
+	connector->display_info.width_mm = nt37701_modes[1].width_mm;
+	connector->display_info.height_mm = nt37701_modes[1].height_mm;
+
+	return count;
+}
+
+static const struct drm_panel_funcs nt37701_panel_funcs = {
+	.prepare = nt37701_prepare,
+	.unprepare = nt37701_unprepare,
+	.get_modes = nt37701_get_modes,
+};
+
+static int nt37701_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return 0;
+}
+
+// TODO: Check if /sys/class/backlight/.../actual_brightness actually returns
+// correct values. If not, remove this function.
+static int nt37701_bl_get_brightness(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness;
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return brightness;
+}
+
+static const struct backlight_ops nt37701_bl_ops = {
+	.update_status = nt37701_bl_update_status,
+	.get_brightness = nt37701_bl_get_brightness,
+};
+
+static struct backlight_device *
+nt37701_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 3514,
+		.max_brightness = 3514,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &nt37701_bl_ops, &props);
+}
+
+static int nt37701_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct nt37701 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct nt37701, panel,
+				   &nt37701_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ret = devm_regulator_bulk_get_const(dev,
+					    ARRAY_SIZE(nt37701_supplies),
+					    nt37701_supplies,
+					    &ctx->supplies);
+	if (ret < 0)
+		return ret;
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	/*
+	 * SM6375 has DSI 6G v2.4, which has no widebus: with DSC enabled the
+	 * destination format has to be RGB888, same as the downstream driver
+	 * (dsi_display.c convierte RGB101010 -> RGB888 si dsc_enabled).
+	 */
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM;
+
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = nt37701_create_backlight(dsi);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to create backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	/* This panel only supports DSC; unconditionally enable it */
+	dsi->dsc = &ctx->dsc;
+
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+
+	/* TODO: Pass slice_per_pkt = 1 */
+	ctx->dsc.slice_height = 12;
+	ctx->dsc.slice_width = 1080;
+	/*
+	 * TODO: hdisplay should be read from the selected mode once
+	 * it is passed back to drm_panel (in prepare?)
+	 */
+	WARN_ON(1080 % ctx->dsc.slice_width);
+	ctx->dsc.slice_count = 1080 / ctx->dsc.slice_width;
+	ctx->dsc.bits_per_component = 10;
+	ctx->dsc.bits_per_pixel = 8 << 4; /* 4 fractional bits */
+	ctx->dsc.block_pred_enable = true;
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void nt37701_remove(struct mipi_dsi_device *dsi)
+{
+	struct nt37701 *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id nt37701_of_match[] = {
+	{ .compatible = "motorola,rhodep-nt37701" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, nt37701_of_match);
+
+static struct mipi_dsi_driver nt37701_driver = {
+	.probe = nt37701_probe,
+	.remove = nt37701_remove,
+	.driver = {
+		.name = "panel-csot-nt37701-655-1080x2400-dsc-v1",
+		.of_match_table = nt37701_of_match,
+	},
+};
+module_mipi_dsi_driver(nt37701_driver);
+
+MODULE_AUTHOR("linux-mdss-dsi-panel-driver-generator <fix@me>"); // FIXME
+MODULE_DESCRIPTION("DRM driver for CSOT NT37701 1080x2400 DSC cmd mode panel (Motorola Moto G82 5G)");
+MODULE_LICENSE("GPL");
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -653,6 +653,16 @@
 	  Say Y here if you want to enable support for Novatek NT37700F DSI
 	  panel module. The panel has a resolution of 1080x2160.
 
+config DRM_PANEL_NOVATEK_NT37701
+	tristate "Novatek NT37701 DSI panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y here if you want to enable support for the Novatek NT37701
+	  1080x2400 AMOLED DSI command mode panel with DSC, as found in
+	  the Motorola Edge 30 and Moto G82 5G.
+
 config DRM_PANEL_NOVATEK_NT37801
 	tristate "Novatek NT37801/NT37810 AMOLED DSI panel"
 	depends on OF
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
