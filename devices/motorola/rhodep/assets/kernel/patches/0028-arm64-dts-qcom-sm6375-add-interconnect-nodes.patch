From: postmarketOS rhodep port
Subject: [PATCH] arm64: dts: qcom: sm6375: add interconnect provider nodes

Add the six NoC provider nodes for SM6375 so drivers can request bus
bandwidth (needed by IPA/mobile data). Register bases, sizes and clocks
match the mainline sm6115.dtsi layout (SM6375 is the same NoC family) and
the downstream Motorola holi.dtsi. The clk_virt/mmrt_virt/mmnrt_virt
virtual buses are children of system_noc, as in sm6115.

Depends on the "interconnect: qcom: add SM6375 NoC provider driver" patch
which adds the qcom,sm6375-{snoc,cnoc,bimc,clk-virt,mmrt-virt,mmnrt-virt}
compatibles and the qcom,sm6375.h binding.

--- a/arch/arm64/boot/dts/qcom/sm6375.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6375.dtsi
@@ -977,6 +977,43 @@
 			reg = <0x0 0x0162f000 0x0 0x84>;
 		};
 
+		system_noc: interconnect@1880000 {
+			compatible = "qcom,sm6375-snoc";
+			reg = <0x0 0x01880000 0x0 0x5f080>;
+			clocks = <&gcc GCC_SYS_NOC_CPUSS_AHB_CLK>,
+				 <&gcc GCC_SYS_NOC_UFS_PHY_AXI_CLK>,
+				 <&gcc GCC_SYS_NOC_USB3_PRIM_AXI_CLK>,
+				 <&rpmcc RPM_SMD_IPA_CLK>;
+			clock-names = "cpu_axi",
+				      "ufs_axi",
+				      "usb_axi",
+				      "ipa";
+			#interconnect-cells = <2>;
+
+			clk_virt: interconnect-clk {
+				compatible = "qcom,sm6375-clk-virt";
+				#interconnect-cells = <2>;
+			};
+
+			mmrt_virt: interconnect-mmrt {
+				compatible = "qcom,sm6375-mmrt-virt";
+				#interconnect-cells = <2>;
+			};
+
+			mmnrt_virt: interconnect-mmnrt {
+				compatible = "qcom,sm6375-mmnrt-virt";
+				#interconnect-cells = <2>;
+			};
+		};
+
+		config_noc: interconnect@1900000 {
+			compatible = "qcom,sm6375-cnoc";
+			reg = <0x0 0x01900000 0x0 0x6200>;
+			clocks = <&gcc GCC_CFG_NOC_USB3_PRIM_AXI_CLK>;
+			clock-names = "usb_axi";
+			#interconnect-cells = <2>;
+		};
+
 		spmi_bus: spmi@1c40000 {
 			compatible = "qcom,spmi-pmic-arb";
 			reg = <0 0x01c40000 0 0x1100>,
@@ -1017,6 +1054,12 @@
 			#qcom,sensors = <11>;
 		};
 
+		bimc: interconnect@4480000 {
+			compatible = "qcom,sm6375-bimc";
+			reg = <0x0 0x04480000 0x0 0x80000>;
+			#interconnect-cells = <2>;
+		};
+
 		rpm_msg_ram: sram@45f0000 {
 			compatible = "qcom,rpm-msg-ram", "mmio-sram";
 			reg = <0 0x045f0000 0 0x7000>;
