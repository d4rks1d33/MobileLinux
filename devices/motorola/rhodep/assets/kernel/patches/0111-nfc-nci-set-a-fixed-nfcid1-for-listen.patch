+
 	rc = nfc_start_poll(dev, im_protocols, tm_protocols);
 	if (!rc)
 		dev->genl_data.poll_req_portid = info->snd_portid;
--- a/net/nfc/nci/core.c	2026-09-01 02:32:20.979409009 +0000
+++ b/net/nfc/nci/core.c	2026-09-01 03:22:00.864579014 +0000
@@ -205,6 +205,19 @@
 			(*num)++;
 		}
 
+		/* Map T2T listen to the FRAME interface so the controller can
+		 * present itself as an NFC-A tag (card emulation). The MIFARE
+		 * Classic protocol (proprietary 0x80) is NOT mapped here: the
+		 * controller rejects RF_DISCOVER_MAP (status 0x1) if 0x80 is
+		 * listed, so MIFARE is only routed via the listen mode routing
+		 * table below, and presented on the T2T/FRAME interface. */
+		if (*num < NCI_MAX_NUM_MAPPING_CONFIGS) {
+			cfg[*num].rf_protocol = NCI_RF_PROTOCOL_T2T;
+			cfg[*num].mode = NCI_DISC_MAP_MODE_LISTEN;
+			cfg[*num].rf_interface = NCI_RF_INTERFACE_FRAME;
+			(*num)++;
+		}
+
 		if (*num == NCI_MAX_NUM_MAPPING_CONFIGS)
 			break;
 	}
@@ -288,6 +301,12 @@
 			NCI_NFC_A_PASSIVE_LISTEN_MODE;
 		cmd.disc_configs[cmd.num_disc_configs].frequency = 1;
 		cmd.num_disc_configs++;
+		/* EXP-2: offer NFC-A and NFC-F listen together, even when
+		 * emulating. NFC-F listen is the one path that does activate on
+		 * this controller, and offering NFC-A alone never arms the A
+		 * listener -- the mainline core also never offers A listen on
+		 * its own. Pairing them may be what makes the firmware arm the
+		 * A listener. */
 		cmd.disc_configs[cmd.num_disc_configs].rf_tech_and_mode =
 			NCI_NFC_F_PASSIVE_LISTEN_MODE;
 		cmd.disc_configs[cmd.num_disc_configs].frequency = 1;
@@ -825,6 +844,80 @@
 	return nci_set_config(ndev, NCI_LF_CON_BITR_F, 1, &val);
 }
 
+static void nci_rf_set_listen_mode_routing_req(struct nci_dev *ndev,
+					       const void *opt)
+{
+	struct nci_rf_set_listen_mode_routing_cmd cmd;
+	struct nci_lmrt_tech_entry *tech;
+	struct nci_lmrt_proto_entry *proto;
+	__u8 *p = cmd.entries;
+
+	memset(&cmd, 0, sizeof(cmd));
+	cmd.more = 0;
+	cmd.num_entries = 0;
+
+	/* Route NFC-A technology to the host so the controller answers the
+	 * anticollision itself and comes up as an NFC-A tag. */
+	tech = (struct nci_lmrt_tech_entry *)p;
+	tech->type = NCI_LMRT_TYPE_TECHNOLOGY;
+	tech->len = 3;
+	tech->nfcee_id = NCI_NFCEE_ID_HOST;
+	tech->power_state = NCI_LMRT_POWER_STATE_ALL;
+	tech->technology = NCI_NFC_RF_TECHNOLOGY_A;
+	p += sizeof(*tech);
+	cmd.num_entries++;
+
+	/* Route the Type 2 tag protocol to the host. */
+	proto = (struct nci_lmrt_proto_entry *)p;
+	proto->type = NCI_LMRT_TYPE_PROTOCOL;
+	proto->len = 3;
+	proto->nfcee_id = NCI_NFCEE_ID_HOST;
+	proto->power_state = NCI_LMRT_POWER_STATE_ALL;
+	proto->protocol = NCI_RF_PROTOCOL_T2T;
+	p += sizeof(*proto);
+	cmd.num_entries++;
+
+	/* Route the MIFARE Classic protocol (Samsung/NXP proprietary 0x80) to
+	 * the host as well. A MIFARE Classic card (SAK 0x08) is presented under
+	 * this protocol, not plain T2T, so without this entry the controller
+	 * accepts the NFC-A listen config but never activates for MIFARE. */
+	proto = (struct nci_lmrt_proto_entry *)p;
+	proto->type = NCI_LMRT_TYPE_PROTOCOL;
+	proto->len = 3;
+	proto->nfcee_id = NCI_NFCEE_ID_HOST;
+	proto->power_state = NCI_LMRT_POWER_STATE_ALL;
+	proto->protocol = NCI_RF_PROTOCOL_MIFARE;
+	p += sizeof(*proto);
+	cmd.num_entries++;
+
+	/* Route NFC-F technology to the host too. This controller performs an
+	 * NFC-F / NFC-DEP listen activation autonomously; by default that
+	 * activation is routed to the UICC (NFCEE 0x83) and the host never sees
+	 * it. Routing NFC-F and NFC-DEP to the host (0x00) makes the activation
+	 * raise RF_INTF_ACTIVATED_NTF to us, which is how we learn what the chip
+	 * actually comes up as when a reader is presented. */
+	tech = (struct nci_lmrt_tech_entry *)p;
+	tech->type = NCI_LMRT_TYPE_TECHNOLOGY;
+	tech->len = 3;
+	tech->nfcee_id = NCI_NFCEE_ID_HOST;
+	tech->power_state = NCI_LMRT_POWER_STATE_ALL;
+	tech->technology = NCI_NFC_RF_TECHNOLOGY_F;
+	p += sizeof(*tech);
+	cmd.num_entries++;
+
+	proto = (struct nci_lmrt_proto_entry *)p;
+	proto->type = NCI_LMRT_TYPE_PROTOCOL;
+	proto->len = 3;
+	proto->nfcee_id = NCI_NFCEE_ID_HOST;
+	proto->power_state = NCI_LMRT_POWER_STATE_ALL;
+	proto->protocol = NCI_RF_PROTOCOL_NFC_DEP;
+	p += sizeof(*proto);
+	cmd.num_entries++;
+
+	nci_send_cmd(ndev, NCI_OP_RF_SET_LISTEN_MODE_ROUTING_CMD,
+		     2 + (p - cmd.entries), &cmd);
+}
+
 static int nci_start_poll(struct nfc_dev *nfc_dev,
 			  __u32 im_protocols, __u32 tm_protocols)
 {
@@ -854,7 +947,8 @@
 			return -EBUSY;
 	}
 
-	if ((im_protocols | tm_protocols) & NFC_PROTO_NFC_DEP_MASK) {
+	if (((im_protocols | tm_protocols) & NFC_PROTO_NFC_DEP_MASK) &&
+	    !nfc_dev->emu_nfcid1_len) {
 		rc = nci_set_local_general_bytes(nfc_dev);
 		if (rc) {
 			pr_err("failed to set local general bytes\n");
@@ -862,7 +956,45 @@
 		}
 	}
 
-	if (tm_protocols & NFC_PROTO_NFC_DEP_MASK) {
+	if (nfc_dev->emu_nfcid1_len) {
+		/* NFC-A tag (card emulation): send a clean NFC-A listen config,
+		 * NOT the NFC-DEP listen parameters, so a reader sees a tag and
+		 * not a P2P peer. */
+		__u8 v;
+
+		/* SENS_RES (ATQA): LA_BIT_FRAME_SDD is the low byte's SDD bits,
+		 * LA_PLATFORM_CONFIG is the high byte. The UID/cascade size bits
+		 * of the low byte are set by the controller from the LENGTH of
+		 * LA_NFCID1 (4->single, 7->double, 10->triple), NOT from
+		 * LA_PLATFORM_CONFIG. For the target ATQA 0x0044 the low byte is
+		 * 0x44 (SDD 0x04 + double-cascade bits from a 7-byte NFCID1) and
+		 * the high byte is 0x00, so both bytes are just their defaults.
+		 * EXP-1: keep LA_PLATFORM_CONFIG = 0x00 (setting the cascade bits
+		 * here corrupts the high ATQA byte). */
+		__u8 dur[2];
+
+		v = 0x04;
+		nci_set_config(ndev, NCI_LA_BIT_FRAME_SDD, 1, &v);
+		v = 0x00;
+		nci_set_config(ndev, NCI_LA_PLATFORM_CONFIG, 1, &v);
+		nci_set_config(ndev, NCI_LA_NFCID1,
+			       nfc_dev->emu_nfcid1_len, nfc_dev->emu_nfcid1);
+		v = nfc_dev->emu_sel_res;
+		nci_set_config(ndev, NCI_LA_SEL_INFO, 1, &v);
+
+		/* EXP-3: give discovery a real total duration (1000 ms, LE) so
+		 * the controller dwells in the NFC-A listen window long enough
+		 * to coincide with a reader's field. */
+		dur[0] = 0xe8;
+		dur[1] = 0x03;
+		nci_set_config(ndev, NCI_TOTAL_DURATION, 2, dur);
+
+		/* Program the listen mode routing table so NFC-A / T2T are
+		 * routed to the host; without this the controller accepts the
+		 * NFC-A listen config but never activates as a tag. */
+		nci_request(ndev, nci_rf_set_listen_mode_routing_req, NULL,
+			    msecs_to_jiffies(NCI_RF_DISC_TIMEOUT));
+	} else if (tm_protocols & NFC_PROTO_NFC_DEP_MASK) {
 		rc = nci_set_listen_parameters(nfc_dev);
 		if (rc)
 			pr_err("failed to set listen parameters\n");
--- a/net/nfc/nci/ntf.c	2026-09-01 02:32:20.980409009 +0000
+++ b/net/nfc/nci/ntf.c	2026-09-01 00:15:13.891657005 +0000
@@ -882,6 +882,14 @@
 					       ndev->remote_gb_len);
 			if (err != NCI_STATUS_OK)
 				pr_err("error when signaling tm activation\n");
+		} else if (err == NCI_STATUS_OK &&
+			   ntf.rf_protocol == NCI_RF_PROTOCOL_T2T) {
+			/* Activated as an NFC-A tag (card emulation). */
+			err = nfc_tm_activated(ndev->nfc_dev,
+					       NFC_PROTO_MIFARE_MASK,
+					       NFC_COMM_PASSIVE, NULL, 0);
+			if (err != NCI_STATUS_OK)
+				pr_err("error when signaling tm activation\n");
 		}
 	}
 
--- a/net/nfc/nci/rsp.c	2026-09-01 02:32:20.982409009 +0000
+++ b/net/nfc/nci/rsp.c	2026-09-01 00:15:13.892657005 +0000
@@ -182,6 +182,16 @@
