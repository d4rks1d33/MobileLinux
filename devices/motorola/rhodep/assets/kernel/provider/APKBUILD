options="!check !strip !tracedeps pmb:cross-native"
_carch="arm64"
_config="config-${pkgname#linux-}.$arch"
builddir="$srcdir/linux-$_kver"

# Used internally by pmbootstrap. Don't touch.
# TODO: Remove once minimum default pmbootstrap version supports
# kernel packages without '_flavor'.
_flavor="${pkgname#linux-}"

prepare() {
	default_prepare
	cp "$srcdir"/"$_config" .config

	# Fill in defaults for symbols the shipped config does not mention, so
	# the build never stops to ask.
	make ARCH="$_carch" LLVM=1 olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-${pkgname#linux-}"
}

package() {
	# Install the plain arm64 Image, not the EFI zboot vmlinuz: Motorola's
	# ABL cannot execute the self decompressing EFI image and resets
	# immediately, which is why CONFIG_EFI_ZBOOT is disabled.
	install -Dm644 "$builddir"/arch/"$_carch"/boot/Image "$pkgdir"/boot/vmlinuz

	make modules_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1

	# Only ship our own DTB: dtbs_install would copy ~145 MiB of device
	# trees for every other platform, which does not fit in the 256 MiB
	# boot partition.
	install -Dm644 "$builddir"/arch/"$_carch"/boot/dts/qcom/sm6375-motorola-rhodep.dtb \
		"$pkgdir"/boot/dtbs/qcom/sm6375-motorola-rhodep.dtb

	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/"${pkgname#linux-}"/kernel.release
}
