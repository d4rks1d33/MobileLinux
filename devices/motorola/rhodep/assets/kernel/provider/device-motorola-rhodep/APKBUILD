# Reference: <https://postmarketos.org/devicepkg>
maintainer="d4rks1d3 <teogorqui1@hotmail.es>"
pkgname=device-motorola-rhodep
pkgver=1
pkgrel=0
pkgdesc="Motorola Moto G82 5G"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
depends="
	android-tools-mkbootimg
	linux-motorola-rhodep
	make-dynpart-mappings
	pd-mapper
	postmarketos-base
	qrtr
	rmtfs
	soc-qcom
	tqftpserv
"
makedepends="devicepkg-dev"
source="
	ath10k-late.conf
	ath10k-late.service
	deviceinfo
	kernel-cmdline.d-earlycon.conf
	modules-initfs
	modules-load.conf
	readonly-firmware.mount
	rhodep-battery-jeita.service
	rhodep-battery-jeita.sh
	rhodep-modem-tmpfiles.conf
	rmtfs-rhodep.conf
"
options="!archcheck !check"

build() {
	devicepkg_build $startdir $pkgname

	# Empty dtbo image: the stock Android overlays must not be applied on
	# top of the mainline DTB. Motorola's fastboot refuses "erase dtbo",
	# so a zero-filled image of the exact partition size is flashed instead.
	dd if=/dev/zero of="$srcdir"/dtbo.img bs=25165824 count=1
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/dtbo.img \
		-t "$pkgdir"/boot/

	install -Dm644 "$srcdir"/modules-load.conf \
		"$pkgdir"/usr/lib/modules-load.d/00-devicepkg-$pkgname.conf

	install -Dm644 "$srcdir"/kernel-cmdline.d-earlycon.conf \
		"$pkgdir"/usr/lib/kernel-cmdline.d/00-earlycon.conf


	# Our own units. rmtfs, pd-mapper and tqftpserv are provided by Alpine
	# (rmtfs-systemd and friends); installing them here overwrote those and
	# made apk add fail. rmtfs only needs different arguments, so that goes in
	# como drop-in.
	for _u in ath10k-late.service readonly-firmware.mount \
		  rhodep-battery-jeita.service; do
		install -Dm644 "$srcdir"/$_u "$pkgdir"/usr/lib/systemd/system/$_u
	done
	install -Dm644 "$srcdir"/rmtfs-rhodep.conf \
		"$pkgdir"/usr/lib/systemd/system/rmtfs.service.d/10-rhodep.conf

	# Enable them, including Alpine's three, which ship disabled.
	install -d "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	for _u in pd-mapper.service rmtfs.service tqftpserv.service \
		  ath10k-late.service readonly-firmware.mount \
		  rhodep-battery-jeita.service; do
		ln -sf ../$_u \
			"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/$_u
	done

	install -Dm755 "$srcdir"/rhodep-battery-jeita.sh \
		"$pkgdir"/usr/bin/rhodep-battery-jeita

	install -Dm644 "$srcdir"/ath10k-late.conf \
		"$pkgdir"/usr/lib/modprobe.d/ath10k-late.conf
	install -Dm644 "$srcdir"/rhodep-modem-tmpfiles.conf \
		"$pkgdir"/usr/lib/tmpfiles.d/rhodep-modem.conf
}

