#!/bin/sh
# Does mainline glink still lose a reference on locally-opened channels?
#
# Opening an endpoint on the modem's DS channel and releasing it again is
# enough. Without kernel/patches/0080 the channel is freed one put too early,
# so the close ack that follows finds nothing and warns:
#
#     close ack on unknown channel
#     WARNING: drivers/rpmsg/qcom_glink_native.c:1755 at qcom_glink_work
#
# and the dangling pointer left in the rcids idr is what later Oopses in
# __pi_strcmp under qcom_glink_create_ept, taking the phone with it.
#
# WARNING: on a kernel WITHOUT that patch this can and does freeze the phone,
# because that is precisely the bug being measured. Run it to confirm a fix,
# not to admire the problem.

set -e
[ "$(id -u)" = 0 ] || { echo "needs root" >&2; exit 1; }
cycles=${1:-3}
pat='close ack on unknown channel'

before=$(dmesg | grep -c "$pat" || true)
up0=$(cut -d' ' -f1 /proc/uptime)
echo "uptime $up0, $before warning(s) already in this boot, $cycles cycle(s) to go"

i=1
while [ "$i" -le "$cycles" ]; do
	rhodep-modem-at ATI >/dev/null 2>&1 || echo "  cycle $i: the console failed"
	sleep 2
	now=$(dmesg | grep -c "$pat" || true)
	echo "  cycle $i: $now warning(s)"
	i=$((i + 1))
done

after=$(dmesg | grep -c "$pat" || true)
left=$(ls /dev/rpmsg[0-9]* 2>/dev/null | wc -l)
echo
echo "uptime $(cut -d' ' -f1 /proc/uptime) (unchanged prefix means no reset)"
echo "leftover endpoints: $left"

if [ "$after" -gt "$before" ]; then
	echo "FAIL: $((after - before)) new warning(s); the reference is still missing."
	dmesg | grep "$pat" | tail -3
	exit 1
fi
echo "PASS: no new warning after $cycles cycle(s)."
