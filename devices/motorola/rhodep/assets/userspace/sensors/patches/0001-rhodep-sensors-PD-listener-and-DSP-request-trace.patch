diff --git a/src/rhodep_sscrpcd.c b/src/rhodep_sscrpcd.c
new file mode 100644
index 0000000..57d0fc5
--- /dev/null
+++ b/src/rhodep_sscrpcd.c
@@ -0,0 +1,51 @@
+// rhodep: single-shot FastRPC listener daemon for the ADSP sensors PD.
+// SPDX-License-Identifier: BSD-3-Clause
+//
+// This is dsprpcd.c without the restart loop.  The stock daemon retries every
+// 100 ms forever, and on this port a failure inside the sensors PD is a fatal
+// error that restarts the whole ADSP -- so a retry loop turns one crash into a
+// reboot storm that takes audio with it.  Here a failure is a failure.
+//
+//   rhodep-sscrpcd [pdname]      default: sensorspd
+
+#include <dlfcn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef int (*listener_start_t)(int argc, char *argv[]);
+
+int main(int argc, char *argv[]) {
+  const char *pd = (argc > 1) ? argv[1] : "sensorspd";
+  char *av[3];
+  listener_start_t start;
+  void *h;
+  int rc;
+
+  h = dlopen("libadsp_default_listener.so.1", RTLD_NOW);
+  if (!h)
+    h = dlopen("libadsp_default_listener.so", RTLD_NOW);
+  if (!h) {
+    fprintf(stderr, "rhodep-sscrpcd: dlopen failed: %s\n", dlerror());
+    return 1;
+  }
+
+  start = (listener_start_t)dlsym(h, "adsp_default_listener_start");
+  if (!start) {
+    fprintf(stderr, "rhodep-sscrpcd: dlsym failed: %s\n", dlerror());
+    return 1;
+  }
+
+  av[0] = argv[0];
+  av[1] = (char *)pd;
+  av[2] = NULL;
+
+  fprintf(stderr, "rhodep-sscrpcd: starting listener for '%s'\n", pd);
+  fflush(stderr);
+
+  rc = start(2, av);
+
+  fprintf(stderr, "rhodep-sscrpcd: listener exited rc=%d (0x%x)\n", rc, rc);
+  return rc ? 1 : 0;
+}
