diff --git a/inc/rhodep_trace.h b/inc/rhodep_trace.h
new file mode 100644
index 0000000..289b0ff
--- /dev/null
+++ b/inc/rhodep_trace.h
@@ -0,0 +1,69 @@
+/* rhodep: trace every apps_std request coming from the DSP.
+ *
+ * The DSP's own file requests are the only log there is of what the sensor
+ * framework wants -- the same lesson the modem taught this port: before
+ * theorising, read what it is asking for.  A missing file is answered with a
+ * plain error and the DSP does not complain, it just asserts several steps
+ * later somewhere unrelated.
+ *
+ * Off unless RHODEP_FASTRPC_TRACE names a file, because on a healthy boot this
+ * is ~2700 lines of registry reads that nobody needs.  To turn it on:
+ *
+ *   systemctl edit rhodep-sscrpcd
+ *     [Service]
+ *     Environment=RHODEP_FASTRPC_TRACE=/var/log/rhodep-fastrpc-trace.log
+ *
+ * Writes straight to the file and flushes every line, deliberately: the thing
+ * being debugged tends to end in an ADSP crash, and a buffered log loses
+ * exactly the last few lines that matter.
+ */
+#ifndef RHODEP_TRACE_H
+#define RHODEP_TRACE_H
+
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+
+static inline void rhodep_trace(const char *fmt, ...) {
+  static FILE *tf;
+  static int tried;
+  static pthread_mutex_t lk = PTHREAD_MUTEX_INITIALIZER;
+  va_list ap;
+  struct timespec ts;
+
+  pthread_mutex_lock(&lk);
+  if (!tf) {
+    const char *path;
+
+    if (tried) {
+      pthread_mutex_unlock(&lk);
+      return;
+    }
+    tried = 1;
+    path = getenv("RHODEP_FASTRPC_TRACE");
+    if (!path || !*path) {
+      pthread_mutex_unlock(&lk);
+      return;
+    }
+    tf = fopen(path, "ae");
+    if (!tf) {
+      pthread_mutex_unlock(&lk);
+      return;
+    }
+  }
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  fprintf(tf, "[%5ld.%03ld] ", (long)ts.tv_sec, ts.tv_nsec / 1000000);
+  va_start(ap, fmt);
+  vfprintf(tf, fmt, ap);
+  va_end(ap);
+  fputc('\n', tf);
+  fflush(tf);
+  pthread_mutex_unlock(&lk);
+}
+
+#define RTRACE(...) rhodep_trace(__VA_ARGS__)
+#define RSTR(s) ((s) ? (s) : "(null)")
+
+#endif /* RHODEP_TRACE_H */
