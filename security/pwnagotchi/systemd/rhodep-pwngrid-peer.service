[Unit]
Description=pwngrid peer for pwnagotchi (rhodep)
Documentation=https://pwnagotchi.org
Wants=network.target
Requires=rhodep-pwn-bettercap.service
After=rhodep-pwn-bettercap.service

[Service]
Type=simple
# Wait for the monitor interface the bettercap service brings up, then peer on
# it. -iface is wlan1mon here, never wlan0mon.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do [ -e /sys/class/net/wlan1mon ] && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/bin/pwngrid -keys /etc/pwnagotchi -peers /root/peers -address 127.0.0.1:8666 -client-token /root/.api-enrollment.json -wait -log /etc/pwnagotchi/log/pwngrid-peer.log -iface wlan1mon
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
